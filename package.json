{
	"name": "games",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"packages/games/*"
	],
	"scripts": {
		"dev": "bun run --filter server --filter web dev",
		"build": "bun run --filter web build",
		"test": "bun test",
		"check": "bun run --filter '*' check",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"typescript": "^6.0.3"
	}
}
