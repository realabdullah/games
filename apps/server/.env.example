# Game server settings. Copy to .env for local development (Bun loads it automatically).
# In production, set these on the server app instead. All are optional.

# Turns on AI-generated question packs. Leave empty to keep the feature off.
# Packs are researched with web search; if web search is turned off for the
# organization in the Claude Console, they're written without source links.
ANTHROPIC_API_KEY=

# AI providers to try, in order; if one fails the next takes over. Providers
# without credentials are skipped. Options: claude-sonnet, claude-opus, claude-haiku
AI_PROVIDERS=claude-sonnet,claude-haiku

# Daily limits on AI packs: per visitor, and for everyone combined.
AI_DAILY_PER_CLIENT=5
AI_DAILY_TOTAL=100

# If set, /metrics requires "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
METRICS_TOKEN=

# How often live rooms are saved, in milliseconds.
SNAPSHOT_EVERY_MS=15000

# Port and data folder. The Docker image already sets PORT=3001 and DATA_DIR=/data.
# PORT=3001
# DATA_DIR=./data
