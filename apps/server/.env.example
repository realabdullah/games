# Game server settings. Copy to .env for local development (Bun loads it automatically).
# In production, set these on the server app instead. All are optional.

# AI-generated question packs. Set a key for each provider you want to use;
# with none set, the feature is off.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Which providers to use, in order of preference; if one fails the next takes
# over. One name is fine too. Providers without a key are skipped, so the
# default works with whichever keys are set.
# Options: claude-sonnet, claude-opus, claude-haiku, gemini, deepseek, kimi
# Claude and Gemini research the topic on the web and link each answer to its
# source; DeepSeek and Kimi write from what the model knows, without sources.
# AI_PROVIDERS=claude-sonnet,gemini,claude-haiku,kimi,deepseek

# Optional model overrides, for when a provider renames or adds models.
# GEMINI_MODEL=gemini-3.8-flash
# DEEPSEEK_MODEL=deepseek-flash
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# Daily limits on AI packs: per visitor, and for everyone combined.
AI_DAILY_PER_CLIENT=5
AI_DAILY_TOTAL=100

# The same providers write emoji riddles and icebreakers in the background, for
# games where the host turns on "AI-written". Batches per day, across all games
# (about 20 items each).
AI_POOL_DAILY_BATCHES=24

# If set, /metrics requires "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
METRICS_TOKEN=

# Ship event logs to Grafana Cloud Loki instead of stdout. All three are needed.
# URL and user: Grafana Cloud portal → your stack → Loki → Details.
# Token: an access policy token with the logs:write scope.
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=

# How often live rooms are saved, in milliseconds.
SNAPSHOT_EVERY_MS=15000

# Port and data folder. The Docker image already sets PORT=3001 and DATA_DIR=/data.
# PORT=3001
# DATA_DIR=./data
